# Expense Tracker API - Environment Configuration Example
# Copy this file to .env and update the values for your environment

# ============================================
# Server Configuration
# ============================================
PORT=5000

# ============================================
# Database Configuration (MySQL)
# ============================================
# Host where MySQL server is running
DB_HOST=localhost

# Port on which MySQL is listening (default: 3306)
DB_PORT=3306

# MySQL username (default: root)
DB_USER=root

# MySQL password (leave empty if no password)
DB_PASSWORD=

# Database name to be created/used
DB_NAME=expense_tracker

# ============================================
# Notes:
# ============================================
# 1. Make sure MySQL service is running before starting the API
# 2. The database will be created automatically on first run
# 3. Keep this file secure and do not commit to version control
# 4. For production, use strong passwords and secure credentials
